{
  "pre-commit": {
    "jobs": [
      {
        "name": "format",
        "run": "npm run -s prettier -- -wu {staged_files}",
        "stage_fixed": true
      }
    ]
  },
  "commit-msg": {
    "commands": {
      "validate": {
        "run": "npm run -s commitlint -- -e {1}"
      }
    }
  }
}
